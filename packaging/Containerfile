# Build environment for the packages: the oldest supported system (Ubuntu
# 22.04, glibc 2.35), so the result runs there and on anything newer.
FROM docker.io/library/ubuntu:22.04

ARG RUST_VERSION
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential pkg-config clang libclang-dev libasound2-dev \
        ca-certificates curl xz-utils file patchelf dpkg-dev python3 \
    && rm -rf /var/lib/apt/lists/*

ENV RUSTUP_HOME=/opt/rustup CARGO_HOME=/opt/cargo PATH=/opt/cargo/bin:$PATH
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
        | sh -s -- -y --profile minimal --default-toolchain "$RUST_VERSION"
